@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Blogs Page");

		JSONLayout.addWidgetToPublicLayout(
			groupName = "Guest",
			layoutName = "Blogs Page",
			widgetName = "Blogs");

		Navigator.gotoPage(pageName = "Blogs Page");

		Blogs.addEntry(
			entryContent = "Abhners Blog Entry Content",
			entryTitle = "Abhners Blog Entry Title");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");
		}
	}

	@description = "Can Create a Blog"
	@priority = "5"
	test CanCreateBlog {
		task ("Add a Widget Page via API and go to the page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");

			Navigator.gotoPage(pageName = "Blogs Page");
		}

		task ("Add a Blog's Widget via API") {
			JSONLayout.addWidgetToPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page",
				widgetName = "Blogs");
		}

		Refresh();

		task ("Add a Blog's entry and Assert Success Message and Blog's Title and Content") {
			Blogs.addEntry(
				entryContent = "Abhners Blog Entry Content",
				entryTitle = "Abhners Blog Entry Title");

			Alert.viewSuccessMessageText(successMessage = "Your request completed successfully.");

			BlogsEntry.viewEntryPG(
				entryContent = "Abhners Blog Entry Content",
				entryTitle = "Abhners Blog Entry Title");
		}
	}

	@description = "Can Delete a Blog"
	@priority = "5"
	test CanDeleteBlog {
		task ("Adding a Second Blog Entry") {
			Blogs.addEntry(
				entryContent = "Blog entry 2 content",
				entryTitle = "Blog entry 2");
		}

		task ("Deleting the First Blog Entry") {
			BlogsEntry.moveToRecycleBinPG(
				entryContent = "Abhners Blog Entry Content",
				entryTitle = "Abhners Blog Entry Title");
		}

		task ("Asserting the Success Message and the New Content and Title") {
			Alert.viewSuccessMessageText(successMessage = "Your request completed successfully.");

			BlogsEntry.viewEntryPG(
				entryContent = "Blog entry 2 content",
				entryTitle = "Blog entry 2");
		}
	}

	@description = "Can Edit a Blog"
	@priority = "5"
	test CanEditBlog {
		task ("Editing Blog's Content and Title") {
			Blogs.editEntryPG(
				entryContent = "Abhners Blog Entry Content",
				entryContentEdit = "New Blogs Entry Content",
				entryTitle = "Abhners Blog Entry Title",
				entryTitleEdit = "New Blogs Entry Title",
				groupName = "Guest");
		}

		task ("Validating Edited Blog's Content and Title") {
			BlogsEntry.viewEntryPG(
				entryContent = "New Blogs Entry Content",
				entryTitle = "New Blogs Entry Title");
		}
	}

}