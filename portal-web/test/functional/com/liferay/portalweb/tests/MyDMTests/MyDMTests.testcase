@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "DM Page");

		JSONLayout.addWidgetToPublicLayout(
			groupName = "Guest",
			layoutName = "DM Page",
			widgetName = "Documents and Media");

		JSONDocument.addFile(
			dmDocumentFile = "Document_1.txt",
			dmDocumentTitle = "DM1 Test",
			groupName = "Guest");

		JSONDocument.addFile(
			dmDocumentFile = "Document_2.txt",
			dmDocumentTitle = "DM2 Test",
			groupName = "Guest");

		Navigator.gotoPage(pageName = "DM Page");

		ProductMenu.gotoPortlet(
			category = "Content & Data",
			portlet = "Documents and Media");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "DM Page");

			User.logoutPG();
		}
	}

	@description = "Can Create a Documents and Media"
	@priority = "5"
	test CanCreateDM {
		DMDocument.addCP(
			dmDocumentFile = "Document_3.txt",
			dmDocumentTitle = "DM3 Test");

		Alert.viewSuccessMessageText(successMessage = "Your request completed successfully.");

		Navigator.gotoPage(pageName = "DM Page");

		DMDocument.viewPG(dmDocumentTitle = "DM3 Test");
	}

	@description = "Can Delete a Documents and Media"
	@priority = "5"
	test CanDeleteDM {
		DMDocument.deleteCP(dmDocumentTitle = "DM1 Test");

		Alert.viewSuccessMessageText(successMessage = "The element DM1 Test was moved to the Recycle Bin.");

		AssertElementPresent(
			key_rowEntry = "DM2 Test",
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");

		AssertElementNotPresent(
			key_rowEntry = "DM1 Test",
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");
	}

	@description = "Can Download a Documents and Media"
	@priority = "5"
	test CanDownloadDM {
		DMDocument.downloadCP(
			dmDocumentSize = "13 B",
			dmDocumentTitle = "DM1 Test");

		DMDocument.assertFileNameFromTempFolder(fileName = "DM1 Test");
	}

	@description = "Can Edit a Documents and Media"
	@priority = "5"
	test CanEditDM {
		DMDocument.editCP(
			dmDocumentFileEdit = "Document_4.txt",
			dmDocumentTitle = "DM1 Test",
			dmDocumentTitleEdit = "DM Edited Test");

		Alert.viewSuccessMessageText(successMessage = "Your request completed successfully.");

		AssertElementPresent(
			key_rowEntry = "DM Edited Test",
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");
	}

}